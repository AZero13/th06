    g_ZunMemory.RemoveFromRegistry(this->pbg3Archives[pbg3FileIdx]); delete (this->pbg3Archives[pbg3FileIdx]); (this->pbg3Archives[pbg3FileIdx]) = 0;
}

i32 Supervisor::LoadPbg3(i32 pbg3FileIdx, char *filename)
{
    if (this->pbg3Archives[pbg3FileIdx] == 0 || strcmp(filename, this->pbg3ArchiveNames[pbg3FileIdx]) != 0)
    {
        this->ReleasePbg3(pbg3FileIdx);
        this->pbg3Archives[pbg3FileIdx] = g_ZunMemory.AddToRegistry(new Pbg3Archive());
        utils::DebugPrint("%s open ...\n", filename);
        if (this->pbg3Archives[pbg3FileIdx]->Load(filename) != 0)
        {
            strcpy(this->pbg3ArchiveNames[pbg3FileIdx], filename);

            char verPath[128];
            sprintf(verPath, "ver%.4x.dat", 0x102);
            i32 res = this->pbg3Archives[pbg3FileIdx]->FindEntry(verPath);
            if (res < 0)
            {
                g_GameErrorContext.Fatal("error : データのバージョンが違います\n");
                return 1;
            }
        }
        else
        {
            
            
            
            
            g_ZunMemory.RemoveFromRegistry(this->pbg3Archives[pbg3FileIdx]); delete (this->pbg3Archives[pbg3FileIdx]); (this->pbg3Archives[pbg3FileIdx]) = 0;
            this->pbg3Archives[pbg3FileIdx] = 0;
        }
    }
    return 0;
}

